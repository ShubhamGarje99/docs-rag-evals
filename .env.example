# Copy to .env and fill in. .env is git-ignored.

# --- Claude (optional: without a key the app runs in retrieval-only mode) ---
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5        # answer model
# CLAUDE_JUDGE_MODEL=claude-haiku-5-5   # LLM-judge model for `make eval-full`
# CLAUDE_EFFORT=low                     # output_config.effort for answers
# CLAUDE_MAX_TOKENS=16000              # includes adaptive-thinking tokens; generous to avoid truncation
# CLAUDE_FALLBACKS=default              # server-side refusal fallback on Sonnet; set to off to disable

# --- Database (docker compose maps Postgres to host port 5433) ---
# DATABASE_URL=postgresql://rag:rag@localhost:5433/rag
# PG_PORT=5433

# --- Retrieval ---
# EMBED_MODEL=BAAI/bge-small-en-v1.5    # or BAAI/bge-m3 (1024-d, ~2.3 GB)
# RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# EMBED_DEVICE=auto                     # auto | mps | cpu | cuda
# RETRIEVER=hybrid                      # vector | bm25 | hybrid | hybrid_rerank
# TOP_K=5
# CANDIDATE_K=30
# MIN_RELEVANCE=0.60                    # refusal gate on max question/chunk cosine
